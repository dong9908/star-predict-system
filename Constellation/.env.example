# Copy this file to .env and enter your Nova Astrometry.net API key.
ASTROMETRY_NET_API_KEY=your_api_key_here

# Identify this research client to Wikimedia. Replace the contact address.
WIKIMEDIA_USER_AGENT=ConstellationResearch/1.0 (contact: your-email@example.com)

# Optional: Openverse currently applies stricter limits to anonymous requests.
# Create API credentials and copy only the values into your local .env file.
OPENVERSE_CLIENT_ID=your_openverse_client_id
OPENVERSE_CLIENT_SECRET=your_openverse_client_secret

# Optional: only needed for private or heavily rate-limited Hugging Face access.
HF_TOKEN=your_huggingface_token
