# Copy this file to .env.docker and replace every CHANGE_ME value.

# MySQL
DB_NAME=astra
DB_USER=astra
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_HOST=db
DB_PORT=3306

# Authentication
ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Front / CORS. Replace with the EC2 address or production domain.
FRONT_ORIGINS=http://localhost
HTTP_PORT=80

# Fortune AI
FORTUNE_AI_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
FORTUNE_AI_MODEL=CHANGE_ME_GROQ_MODEL
FORTUNE_AI_TIMEOUT_SECONDS=30
FORTUNE_AI_MAX_RETRIES=1

# KakaoPay
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=CHANGE_ME_KAKAOPAY_DEV_SECRET_KEY
KAKAOPAY_APPROVAL_URL=http://localhost/payment/success
KAKAOPAY_CANCEL_URL=http://localhost/payment/cancel
KAKAOPAY_FAIL_URL=http://localhost/payment/fail
KAKAOPAY_TIMEOUT_SECONDS=15
FORTUNE_PRODUCT_NAME=ASTRA Fortune
FORTUNE_PRODUCT_PRICE=1000

# Plate Solving
PLATE_SOLVE_TIMEOUT_SECONDS=90
PLATE_SOLVE_SCALE_LOWER=5
PLATE_SOLVE_SCALE_UPPER=160
PLATE_SOLVE_DOWNSAMPLE=4
PLATE_SOLVE_TWO_STAGE_RETRY=true
PLATE_SOLVE_SECOND_STAGE_TIMEOUT_SECONDS=75
